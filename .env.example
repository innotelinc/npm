# Copy to .env and set real values. Used by the root docker-compose.yml.
# Use different long random values for each secret.
DB_MYSQL_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# First-run admin, created only while the user table is empty. Without it a
# fresh instance has to be claimed through the setup wizard.
INITIAL_ADMIN_EMAIL=admin@innotel.us
INITIAL_ADMIN_PASSWORD=

# Host ports. Defaults preserve the standard NPM deployment ports.
# The bundled edge (compose.cerulean.yml) reads the NPM_-prefixed names from
# Cerulean's .env instead — including NPM_BACKUP_UI_PORT.
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81
BACKUP_UI_PORT=82

# Scheduled settings backups. Empty CRON_SCHEDULE disables the scheduler.
CRON_SCHEDULE='0 2 * * *'
BACKUP_RETENTION=7

# Optional Basic Authentication for backup-ui (http://<host>:82).
# Set both values before exposing backup-ui outside a private management network.
BACKUP_UI_USER=
BACKUP_UI_PASSWORD=

# --- Authentik forward-auth sign-in for the admin UI (optional) -------------
# Off by default. With SSO on, the admin UI signs in with the identity the edge
# already authenticated and the password form is closed on every gated door —
# NPM is the edge, not a second user directory (docs/stack.md).
#
# The proxy host that fronts the admin UI must forward to the UI's LOOPBACK
# address (127.0.0.1, admin port). This image's admin vhost then vouches for the
# request (X-NPM-Edge: yes) and the app believes X-authentik-* — a client
# reaching :81 directly cannot make the vhost say yes, and forging the header
# itself is overwritten. A host forwarding to the LAN IP simply gets no SSO.
AUTH_SSO_ENABLED=
# Override only if you front the API with a different vhost that sets its own
# verdict header.
AUTH_SSO_EDGE_HEADER=
# Authentik group an identity must be in to use the admin UI. Empty = any
# identity the gateway vouches for (only ever ask for that deliberately).
AUTH_SSO_REQUIRED_GROUP=cerulean-platform
# Group whose members get NPM's `admin` role; everyone else gets `user`.
AUTH_SSO_ADMIN_GROUP=cerulean-platform
# Create the NPM user for an Authentik identity on first sign-in (no password
# row is ever written for it).
AUTH_SSO_AUTO_CREATE=1

# Automation accounts still allowed to use the email+password grant off-edge
# (anything reaching the API through the edge is refused). Comma-separated.
# They call the API directly; listing one here does NOT bring the login form back.
AUTH_SERVICE_ACCOUNTS=
# Break-glass recovery: re-enables the password form. Unset it again afterwards.
BREAKGLASS_LOGIN=

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) ------------
# Cerulean provisions the public DNS names, NPM proxy hosts, and TLS
# certificates for every Innotel platform. NPM Edge is the edge itself:
# Cerulean's automation exports/attaches certificate material here and
# provisions proxy hosts through the NPM API. That API URL and the admin
# credentials live in Cerulean's .env (NPM_API_URL, NPM_EMAIL, NPM_PASSWORD);
# the bundled edge is enabled there with NPM_MODE=local.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_ZONE=innotel.us

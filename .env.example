# Copy to .env and set real values. Used by the root docker-compose.yml.
# Use different long random values for each secret.
DB_MYSQL_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# First-run admin, created only while the user table is empty. Without it a
# fresh instance has to be claimed through the setup wizard.
INITIAL_ADMIN_EMAIL=admin@innotel.us
INITIAL_ADMIN_PASSWORD=

# Host ports. Defaults preserve the standard NPM deployment ports.
# The bundled edge (compose.cerulean.yml) reads the NPM_-prefixed names from
# Cerulean's .env instead — including NPM_BACKUP_UI_PORT.
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81
BACKUP_UI_PORT=82

# Scheduled settings backups. Empty CRON_SCHEDULE disables the scheduler.
CRON_SCHEDULE='0 2 * * *'
BACKUP_RETENTION=7

# Optional Basic Authentication for backup-ui (http://<host>:82).
# Set both values before exposing backup-ui outside a private management network.
BACKUP_UI_USER=
BACKUP_UI_PASSWORD=

# --- Cerulean Authentik SSO for the admin UI (optional) ---------------------
# Off by default. With SSO on, the admin UI signs in with the identity the
# platform's SSO gateway (oauth2-proxy) established after a real OIDC code flow
# against Cerulean's Authentik, and the password form is closed — NPM is the
# edge, not a second user directory (docs/stack.md).
#
# The gateway runs in the edge's network namespace (`cerulean-npm-sso`, see
# compose.cerulean.yml). The proxy host that fronts the admin UI forwards to the
# gateway's loopback port (NPM_SSO_GATEWAY_PORT), not to :81; the gateway then
# forwards the authenticated request to :81, where this image's admin vhost sees
# a loopback peer and vouches for it (X-NPM-Edge: yes). A client reaching :81
# directly cannot make the vhost say yes, and forging the identity headers is
# overwritten. A host forwarding to the LAN IP simply gets no SSO.
AUTH_SSO_ENABLED=
# Override only if you front the API with a different vhost that sets its own
# verdict header.
AUTH_SSO_EDGE_HEADER=
# Authentik group an identity must be in to use the admin UI. Empty = any
# identity the gateway vouches for (only ever ask for that deliberately).
AUTH_SSO_REQUIRED_GROUP=cerulean-platform
# Group whose members get NPM's `admin` role; everyone else gets `user`.
AUTH_SSO_ADMIN_GROUP=cerulean-platform
# Authentik group the gateway itself admits (oauth2-proxy --allowed-group).
# Keep it the same as AUTH_SSO_REQUIRED_GROUP: the gateway is the door, the
# backend check is the lock on the other side of it.
SSO_REQUIRED_GROUP=cerulean-platform
# Create the NPM user for an Authentik identity on first sign-in (no password
# row is ever written for it).
AUTH_SSO_AUTO_CREATE=1

# Automation accounts still allowed to use the email+password grant off-edge
# (anything reaching the API through the edge is refused). Comma-separated.
# They call the API directly; listing one here does NOT bring the login form back.
AUTH_SERVICE_ACCOUNTS=
# Break-glass recovery: re-enables the password form. Unset it again afterwards.
BREAKGLASS_LOGIN=

# --- SSO gateway (oauth2-proxy) -------------------------------------------
# One OIDC client per SSO surface, registered in Authentik by
# `scripts/authentik-setup.py npm-edge` (cerulean repo). The gateway is a real
# OIDC relying party: the browser does the code flow against Authentik, no
# outpost and no auth_request anywhere in the path.
#
# Provision the client once with `scripts/authentik-setup.py npm-edge` (cerulean
# repo), then set the matching values here.
NPM_SSO_GATEWAY_PORT=4180
# Authentik's base URL for this zone (NOT AUTHENTIK_ISSUER_URL, which is the
# Cerulean application's issuer and already carries /application/o/cerulean).
NPM_SSO_AUTHENTIK_BASE=https://auth.cerulean.innotel.us
# The Authentik application slug registered by `authentik-setup.py npm-edge`.
NPM_SSO_APP_SLUG=npm-edge
NPM_SSO_CLIENT_ID=npm-edge
NPM_SSO_CLIENT_SECRET=
NPM_SSO_REDIRECT_URL=https://proxy.innotel.us/oauth2/callback
# Shared across every gateway in the stack, so one sign-in covers them all.
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
SSO_COOKIE_SECRET=
SSO_COOKIE_DOMAIN=.innotel.us

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) ------------
# Cerulean provisions the public DNS names, NPM proxy hosts, and TLS
# certificates for every Innotel platform. NPM Edge is the edge itself:
# Cerulean's automation exports/attaches certificate material here and
# provisions proxy hosts through the NPM API. That API URL and the admin
# credentials live in Cerulean's .env (NPM_API_URL, NPM_EMAIL, NPM_PASSWORD);
# the bundled edge is enabled there with NPM_MODE=local.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_ZONE=innotel.us

[TEMPLATE]
# Copy to .env and set real values. Used by the root docker-compose.yml.
# Use different long random values for each secret.
DB_MYSQL_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Host ports. Defaults preserve the standard NPM deployment ports.
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81
BACKUP_UI_PORT=82

# Scheduled settings backups. Empty CRON_SCHEDULE disables the scheduler.
CRON_SCHEDULE=0 2 * * *
BACKUP_RETENTION=7

# Optional Basic Authentication for backup-ui (http://<host>:82).
# Set both values before exposing backup-ui outside a private management network.
BACKUP_UI_USER=
BACKUP_UI_PASSWORD=
